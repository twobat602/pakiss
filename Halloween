-- === AUTO FARM FUNCTIONALITY === --
local lastRunTime = 0
local autoFarmConnection

-- Hanapin yung RemoteEvent
local SubmitJackOLanternItem = ReplicatedStorage:WaitForChild("GameEvents"):WaitForChild("SubmitJackOLanternItem")

local function executeAutoFarm()
    local char = player.Character
    if not char then return end
    
    local backpack = player:FindFirstChild("Backpack")
    local humanoid = char:FindFirstChildOfClass("Humanoid")

    if humanoid and backpack then
        for _, tool in pairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then
                if string.find(tool.Name, itemName) and not string.find(tool.Name, skipName) then
                    -- Equip the tool
                    humanoid:EquipTool(tool)
                    
                    -- Wait konti para ma-ensure na na-equip
                    wait(0.05)
                    
                    -- Fire server to submit
                    local args = {
                        [1] = "Held"
                    }
                    
                    pcall(function()
                        SubmitJackOLanternItem:FireServer(unpack(args))
                    end)
                    
                    break
                end
            end
        end
    end
end

local function startAutoFarm()
    if autoFarmConnection then
        autoFarmConnection:Disconnect()
    end
    
    autoFarmConnection = RunService.Heartbeat:Connect(function()
        if not running then return end
        
        local currentTime = tick()
        if currentTime - lastRunTime < currentSpeed then return end
        
        executeAutoFarm()
        lastRunTime = currentTime
    end)
end

local function stopAutoFarm()
    running = false
    if autoFarmConnection then
        autoFarmConnection:Disconnect()
        autoFarmConnection = nil
    end
end

